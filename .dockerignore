.git/
.gitignore
.venv/
__pycache__/
*.pyc
.DS_Store
tunedeck.db
# Raw OCR from scripts/build_pagemaps.py — a build-time cache, megabytes of it,
# and nothing at runtime reads it (data/pagemaps.json is the shipped output).
data/.pagemap_ocr.json
frontend/node_modules/
frontend/dist/
jazz_standard_picker_handoff.md
CLAUDE.md
README.md
# Secrets never belong in the image — production reads Fly secrets from the
# environment. A bare ".env.local" would only match the context root, and
# `COPY frontend/ ./` would still carry frontend/.env.local into the build
# stage, so match at any depth.
**/.env
**/.env.*
!**/.env.example